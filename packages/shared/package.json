{
  "name": "@repopilot/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./env": {
      "types": "./src/env.ts",
      "default": "./src/env.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./schemas": {
      "types": "./src/schemas/run.ts",
      "default": "./src/schemas/run.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "bullmq": "6.3.10",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "uuid": "13.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15"
  }
}
