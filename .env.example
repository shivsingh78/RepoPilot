# Host ports for the compose postgres/redis (override if 5432/6379 are taken)
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- shared ----
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://repopilot:repopilot@localhost:5432/repopilot
REDIS_URL=redis://localhost:6379

# ---- api ----
PORT=4000
# Comma-separated client API keys. Leave empty in dev to disable auth.
API_KEYS=
CORS_ORIGIN=http://localhost:3000

# ---- worker ----
WORKER_HEALTH_PORT=4001
PIPELINE_CONCURRENCY=5
SANDBOX_CONCURRENCY=2
WORKSPACE_ROOT=./workspaces
# Required once AI stages are implemented (Day 2+). Worker only. Never given to api/web/sandbox.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional for local dev; production uses a GitHub App (see docs/SECURITY.md).
GITHUB_TOKEN=

# ---- web ----
API_BASE_URL=http://localhost:4000
API_KEY=
